    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let value = $json.text;\n\ntry {\n  // Remove markdown code fences if the AI added them\n  value = value\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/\\s*```$/i, '')\n    .trim();\n\n  // First parse\n  let parsed = JSON.parse(value);\n\n  // Parse again when the first result is still a JSON string\n  if (typeof parsed === 'string') {\n    parsed = JSON.parse(parsed);\n  }\n\n  return {\n    json: parsed\n  };\n\n} catch (error) {\n  return {\n    json: {\n      parse_status: \"FAILED\",\n      error: error.message,\n      raw_text: $json.text\n    }\n  };\n}"
      },
